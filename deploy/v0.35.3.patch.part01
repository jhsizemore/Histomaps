+
+/* ---------- v0.35 public-facing welcome + credits ---------- */
+.public-credit {
+  position: fixed;
+  z-index: 22;
+  left: 50%;
+  bottom: calc(7px + var(--safe-bottom));
+  transform: translateX(-50%);
+  max-width: calc(100vw - 28px);
+  padding: 4px 9px;
+  border: 1px solid rgba(65,49,34,.13);
+  border-radius: 999px;
+  background: rgba(247,240,224,.84);
+  box-shadow: 0 3px 12px rgba(52,40,26,.07);
+  color: rgba(60,49,39,.76);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 8px;
+  font-weight: 650;
+  letter-spacing: .025em;
+  line-height: 1.25;
+  text-align: center;
+  white-space: nowrap;
+  backdrop-filter: blur(2px);
+  -webkit-backdrop-filter: blur(2px);
+  pointer-events: auto;
+}
+
+.public-credit a {
+  color: rgba(48,35,25,.9);
+  font-weight: 800;
+  text-decoration: none;
+  border-bottom: 1px solid rgba(48,35,25,.28);
+}
+
+.public-credit a:hover,
+.public-credit a:focus-visible {
+  color: var(--accent);
+  border-bottom-color: currentColor;
+}
+
+.public-credit button {
+  appearance: none;
+  border: 0;
+  border-bottom: 1px solid rgba(48,35,25,.28);
+  padding: 0;
+  background: transparent;
+  color: rgba(48,35,25,.9);
+  font: inherit;
+  font-weight: 800;
+  letter-spacing: inherit;
+  cursor: pointer;
+}
+.public-credit button:hover,
+.public-credit button:focus-visible {
+  color: var(--accent);
+  border-bottom-color: currentColor;
+  outline: none;
+}
+
+.sparks-bio-overlay {
+  position: fixed;
+  z-index: 1010;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: max(22px, var(--safe-top)) max(18px, var(--safe-right)) max(22px, var(--safe-bottom)) max(18px, var(--safe-left));
+  background: rgba(29,24,19,.50);
+  backdrop-filter: blur(6px);
+  -webkit-backdrop-filter: blur(6px);
+  opacity: 1;
+  visibility: visible;
+  transition: opacity .2s ease, visibility .2s ease;
+}
+.sparks-bio-overlay[hidden] { display: none; }
+.sparks-bio-overlay.is-closing { opacity: 0; visibility: hidden; }
+
+.sparks-bio-card {
+  position: relative;
+  width: min(820px, 100%);
+  max-height: min(780px, calc(100dvh - 44px));
+  overflow: auto;
+  border: 1px solid rgba(74,55,35,.28);
+  border-radius: 19px;
+  background: linear-gradient(180deg, rgba(251,247,237,.995), rgba(237,226,204,.99));
+  box-shadow: 0 32px 82px rgba(24,18,13,.32);
+  color: var(--ink);
+}
+.sparks-bio-grid {
+  display: grid;
+  grid-template-columns: minmax(190px, 238px) minmax(0, 1fr);
+}
+.sparks-bio-visual {
+  min-height: 100%;
+  padding: 34px 27px 30px;
+  border-right: 1px solid rgba(74,55,35,.16);
+  background:
+    radial-gradient(circle at 28% 12%, rgba(255,255,255,.76), transparent 32%),
+    linear-gradient(165deg, rgba(205,187,154,.52), rgba(119,97,70,.18));
+}
+.sparks-bio-portrait-frame {
+  width: min(170px, 100%);
+  margin: 2px auto 17px;
+  padding: 7px;
+  border: 1px solid rgba(61,46,33,.28);
+  background: #eee4d0;
+  box-shadow: 0 12px 26px rgba(49,37,25,.14);
+  transform: rotate(-.45deg);
+}
+.sparks-bio-portrait {
+  display: block;
+  width: 100%;
+  aspect-ratio: 2 / 3;
+  object-fit: cover;
+  filter: sepia(.12) contrast(1.04);
+}
+.sparks-bio-photo-note {
+  margin: 0 auto;
+  max-width: 178px;
+  color: rgba(70,56,44,.64);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 8px;
+  line-height: 1.45;
+}
+.sparks-bio-photo-note a { color: inherit; }
+.sparks-bio-dates {
+  margin: 20px auto 0;
+  max-width: 178px;
+  padding-top: 13px;
+  border-top: 1px solid rgba(69,52,37,.20);
+  color: rgba(54,41,31,.82);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 9px;
+  font-weight: 850;
+  letter-spacing: .11em;
+  text-transform: uppercase;
+}
+.sparks-bio-content { padding: 38px 42px 35px; }
+.sparks-bio-eyebrow {
+  margin: 0 0 9px;
+  color: var(--accent);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 9px;
+  font-weight: 900;
+  letter-spacing: .18em;
+  text-transform: uppercase;
+}
+.sparks-bio-content h2 {
+  margin: 0 42px 7px 0;
+  font-size: clamp(34px, 5.4vw, 49px);
+  font-weight: 520;
+  line-height: .99;
+  letter-spacing: -.035em;
+}
+.sparks-bio-deck {
+  margin: 0 0 22px;
+  color: rgba(71,56,43,.68);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .045em;
+  text-transform: uppercase;
+}
+.sparks-bio-content h3 {
+  margin: 22px 0 7px;
+  color: rgba(51,39,30,.86);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 9px;
+  font-weight: 900;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+}
+.sparks-bio-content p {
+  margin: 0 0 12px;
+  color: rgba(48,39,31,.88);
+  font-size: 13px;
+  line-height: 1.57;
+}
+.sparks-bio-caveat {
+  margin: 20px 0 0;
+  padding: 14px 16px;
+  border-left: 2px solid rgba(107,75,48,.56);
+  background: rgba(255,255,255,.30);
+}
+.sparks-bio-caveat h3 { margin-top: 0; }
+.sparks-bio-caveat p:last-child { margin-bottom: 0; }
+.sparks-bio-sources {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 7px 12px;
+  margin-top: 19px;
+  padding-top: 13px;
+  border-top: 1px solid rgba(67,51,37,.16);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 8px;
+  font-weight: 750;
+}
+.sparks-bio-sources span { color: rgba(69,55,44,.56); letter-spacing: .08em; text-transform: uppercase; }
+.sparks-bio-sources a { color: rgba(55,41,30,.78); text-decoration: none; border-bottom: 1px solid rgba(55,41,30,.22); }
+.sparks-bio-sources a:hover { color: var(--accent); border-bottom-color: currentColor; }
+.sparks-bio-close {
+  position: absolute;
+  z-index: 2;
+  top: 13px;
+  right: 14px;
+  width: 34px;
+  height: 34px;
+  border: 1px solid rgba(58,44,32,.22);
+  border-radius: 50%;
+  background: rgba(249,243,231,.86);
+  color: rgba(55,42,31,.82);
+  font-size: 21px;
+  line-height: 1;
+  cursor: pointer;
+}
+.sparks-bio-close:hover { background: #fffaf0; color: var(--accent); }
+.sparks-bio-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+/* ---------- v0.35.3 public trust / provenance + header identity ---------- */
+.public-info-overlay {
+  position: fixed;
+  z-index: 1008;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: max(22px, var(--safe-top)) max(18px, var(--safe-right)) max(22px, var(--safe-bottom)) max(18px, var(--safe-left));
+  background: rgba(29,24,19,.48);
+  backdrop-filter: blur(6px);
+  -webkit-backdrop-filter: blur(6px);
+  opacity: 1;
+  visibility: visible;
+  transition: opacity .2s ease, visibility .2s ease;
+}
+.public-info-overlay[hidden] { display: none; }
+.public-info-overlay.is-closing { opacity: 0; visibility: hidden; }
+.public-info-card {
+  position: relative;
+  width: min(720px, 100%);
+  max-height: min(790px, calc(100dvh - 44px));
+  overflow: auto;
+  padding: clamp(29px, 5vw, 46px);
+  border: 1px solid rgba(74,55,35,.27);
+  border-radius: 19px;
+  background: linear-gradient(180deg, rgba(251,247,237,.995), rgba(237,226,204,.99));
+  box-shadow: 0 32px 82px rgba(24,18,13,.30);
+  color: var(--ink);
+}
+.public-info-card .public-info-eyebrow {
