+  font-size: clamp(34px, 6vw, 50px);
+  font-weight: 520;
+  line-height: .99;
+  letter-spacing: -.035em;
+}
+.public-info-card h3 {
+  margin: 24px 0 7px;
+  color: rgba(51,39,30,.86);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 9px;
+  font-weight: 900;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+}
+.public-info-card p, .public-info-card li {
+  color: rgba(48,39,31,.88);
+  font-size: 13px;
+  line-height: 1.58;
+}
+.public-info-card p { margin: 0 0 12px; }
+.public-info-card ul { margin: 8px 0 15px; padding-left: 20px; }
+.public-info-card li { margin: 0 0 6px; }
+.public-info-card a { color: rgba(53,38,26,.88); font-weight: 750; text-decoration: none; border-bottom: 1px solid rgba(53,38,26,.26); }
+.public-info-card a:hover, .public-info-card a:focus-visible { color: var(--accent); border-bottom-color: currentColor; }
+.public-info-note {
+  margin-top: 19px !important;
+  padding: 13px 15px;
+  border-left: 2px solid rgba(107,75,48,.56);
+  background: rgba(255,255,255,.30);
+}
+.public-info-meta {
+  margin-top: 22px;
+  padding-top: 13px;
+  border-top: 1px solid rgba(67,51,37,.16);
+  color: rgba(69,55,44,.58) !important;
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 8px !important;
+  font-weight: 750;
+  letter-spacing: .055em;
+  text-transform: uppercase;
+}
+.public-info-close {
+  position: absolute;
+  top: 13px;
+  right: 14px;
+  width: 34px;
+  height: 34px;
+  border: 1px solid rgba(58,44,32,.22);
+  border-radius: 50%;
+  background: rgba(249,243,231,.86);
+  color: rgba(55,42,31,.82);
+  font-size: 21px;
+  line-height: 1;
+  cursor: pointer;
+}
+.public-info-close:hover { background: #fffaf0; color: var(--accent); }
+.public-info-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.public-credit .credit-separator { opacity: .46; padding: 0 2px; }
+.public-credit .credit-copyright { color: rgba(60,49,39,.68); }
+
+.welcome-overlay {
+  position: fixed;
+  z-index: 1000;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: max(22px, var(--safe-top)) max(18px, var(--safe-right)) max(22px, var(--safe-bottom)) max(18px, var(--safe-left));
+  background: rgba(35,29,23,.38);
+  backdrop-filter: blur(5px);
+  -webkit-backdrop-filter: blur(5px);
+  opacity: 1;
+  visibility: visible;
+  transition: opacity .22s ease, visibility .22s ease;
+}
+
+.welcome-seen .welcome-overlay,
+.welcome-overlay[hidden] {
+  display: none;
+}
+
+.welcome-overlay.is-closing {
+  opacity: 0;
+  visibility: hidden;
+}
+
+.welcome-card {
+  width: min(590px, 100%);
+  max-height: min(720px, calc(100dvh - 44px));
+  overflow: auto;
+  padding: clamp(25px, 5vw, 44px);
+  border: 1px solid rgba(74,55,35,.26);
+  border-radius: 18px;
+  background:
+    linear-gradient(180deg, rgba(251,247,237,.99), rgba(239,229,207,.985));
+  box-shadow: 0 28px 70px rgba(31,24,17,.24);
+  color: var(--ink);
+}
+
+.welcome-eyebrow {
+  margin: 0 0 10px;
+  color: var(--accent);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 9px;
+  font-weight: 900;
+  letter-spacing: .19em;
+  text-transform: uppercase;
+}
+
+.welcome-card h2 {
+  margin: 0 0 17px;
+  font-size: clamp(34px, 7vw, 54px);
+  font-weight: 500;
+  line-height: .98;
+  letter-spacing: -.035em;
+}
+
+.welcome-card p {
+  margin: 0 0 13px;
+  color: rgba(48,39,31,.88);
+  font-size: 14px;
+  line-height: 1.58;
+}
+
+.welcome-card .welcome-reading-note {
