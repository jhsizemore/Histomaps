+  font-size: 12px;
+}
+
+.welcome-actions {
+  display: flex;
+  align-items: center;
+  gap: 13px;
+  margin-top: 24px;
+}
+
+.welcome-enter {
+  min-height: 44px;
+  padding: 10px 17px;
+  border: 1px solid rgba(48,35,25,.62);
+  border-radius: 999px;
+  background: #35271d;
+  color: #fbf6ea;
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 10px;
+  font-weight: 900;
+  letter-spacing: .085em;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+
+.welcome-enter:hover { background: #241a13; }
+.welcome-enter:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
+
+.welcome-hint {
+  color: rgba(83,69,57,.64);
+  font-family: "Helvetica Neue", Arial, sans-serif;
+  font-size: 9px;
+  line-height: 1.35;
+}
+
+@media (max-width: 620px) {
+  .public-credit {
+    bottom: calc(5px + var(--safe-bottom));
+    max-width: calc(100vw - 18px);