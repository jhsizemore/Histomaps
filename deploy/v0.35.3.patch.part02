+    font-size: 7px;
+    white-space: normal;
+  }
+  .welcome-card {
+    border-radius: 15px;
+    padding: 27px 23px 25px;
+  }
+  .welcome-card h2 { font-size: 39px; }
+  .welcome-card p { font-size: 13px; }
+  .welcome-actions { align-items: flex-start; flex-direction: column; }
+  .sparks-bio-grid { grid-template-columns: 1fr; }
+  .sparks-bio-visual {
+    display: grid;
+    grid-template-columns: 108px minmax(0, 1fr);
+    column-gap: 17px;
+    align-items: end;
+    padding: 25px 24px 20px;
+    border-right: 0;
+    border-bottom: 1px solid rgba(74,55,35,.16);
+  }
+  .sparks-bio-portrait-frame { margin: 0; width: 108px; }
+  .sparks-bio-photo-note { align-self: start; max-width: none; margin: 3px 0 0; }
+  .sparks-bio-dates { grid-column: 2; margin: -25px 0 0; max-width: none; }
+  .sparks-bio-content { padding: 29px 24px 28px; }
+  .sparks-bio-content h2 { font-size: 38px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .welcome-overlay, .sparks-bio-overlay, .public-info-overlay { transition: none; }
+}
